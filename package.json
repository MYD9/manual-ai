  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/build.mjs",
    "start": ".venv\\Scripts\\python.exe scripts/launcher.py start",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
